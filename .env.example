# Copiá este archivo como .env y cambiá las contraseñas.

# Conexión a PostgreSQL (usuario administrador: crea tablas y carga datos)
# Puerto 5433 para no chocar con un PostgreSQL local que use el 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=repuestos
POSTGRES_USER=repuestos_admin
POSTGRES_PASSWORD=cambiar_esta_clave

# Rol de solo lectura que usará el agente de IA
AGENTE_DB_USER=agente_lectura
AGENTE_DB_PASSWORD=cambiar_esta_otra_clave
